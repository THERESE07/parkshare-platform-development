# ParkShare API base URL (no trailing /api). Local Docker backend: http://localhost:8080
# Never put secrets in VITE_ variables: they are bundled into browser code.
VITE_API_URL=http://localhost:8080

# Show the "Test mode: no real money" notice on payments (sandbox gateway). Set to false in production.
VITE_PAYMENTS_SANDBOX=true

# Optional: map tiles and routing. Defaults use OpenStreetMap tiles and the public OSRM demo router.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_ROUTING_URL=https://router.project-osrm.org
